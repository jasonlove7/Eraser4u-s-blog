---
/**
 * 首页。
 *
 * Phase 2 阶段：先接入完整的页头氛围（天空 / 云 / 城市 / 前景）与开场标题。
 * 后续的滚动叙事分镜（技术领域、最新文章、项目轨迹）在 Phase 3 补齐。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AtmosphereHeader from '../components/atmosphere/AtmosphereHeader.astro';
import Hero from '../components/home/Hero.astro';
import { site } from '../config/site';
---

<BaseLayout weather={site.theme.hero} path="" overlayHeader>
  <AtmosphereHeader variant="hero" horizon={66}>
    <Hero />
  </AtmosphereHeader>
</BaseLayout>
