---
/**
 * 首页 —— Phase 1 临时版本。
 * 真正的「电影开场」在 Phase 3 实现，这里先验证设计系统与布局骨架是否接通。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout weather={site.theme.hero} noindex>
  <section class="placeholder">
    <h1 class="placeholder__title">{site.author.handle}</h1>
    <p class="placeholder__signature">{site.author.signature}</p>
  </section>
</BaseLayout>

<style>
  .placeholder {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding: var(--space-10) var(--gutter);
  }

  .placeholder__title {
    font-size: var(--text-hero);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    margin: 0;
  }

  .placeholder__signature {
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--ink-muted);
  }
</style>
