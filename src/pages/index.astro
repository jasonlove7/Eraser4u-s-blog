---
/**
 * 首页 —— 一条连续的镜头轨迹。
 *
 * 分镜：
 *   1. 开场      满屏天空 + 城市 + 前景电线；名字、轮播标语、方向清单
 *   2. 一句话     镜头落下，进入安静的中性表面
 *   3. 分类       从哪里开始读
 *   4. 最近写的
 *
 * 关键约束：**氛围只出现在第 1 幕**。滚过 Hero 之后页面必须迅速安静下来 ——
 * 没有渐变、没有图片、没有视差。这是"电影开场"和"花哨网页"的分界线。
 *
 * 文案与列表全部来自 src/data/ 与 src/config/，这个文件里没有硬编码的内容。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AtmosphereHeader from '../components/atmosphere/AtmosphereHeader.astro';
import Hero from '../components/home/Hero.astro';
import HomeSection from '../components/home/HomeSection.astro';
import HomeExplore from '../components/home/HomeExplore.astro';
import HomePosts from '../components/home/HomePosts.astro';
import { site } from '../config/site';
import { intro } from '../data/about';
import { getPosts, collectCategories } from '../utils/posts';
import { withBase } from '../utils/url';

const posts = await getPosts();
const latest = posts.slice(0, 4);
const categoryCounts = collectCategories(posts);
---

<BaseLayout
  weather={site.theme.hero}
  path=""
  description={`${site.title} —— ${site.description}`}
  overlayHeader
>
  <AtmosphereHeader variant="hero" horizon={66}>
    <Hero />
  </AtmosphereHeader>

  <div class="home">
    <!-- 2. 一句话 -->
    <section class="intro">
      <p class="intro__lead">
        这里是 <strong>{site.author.handle}</strong>。{intro[0]}
      </p>
      <p class="intro__more">
        <a href={withBase('about/')}>关于这个博客 <span aria-hidden="true">→</span></a>
      </p>
    </section>

    <!-- 3. 从哪里开始读 -->
    <HomeSection
      id="explore"
      eyebrow="Browse"
      title="从哪儿开始"
      moreHref={withBase('categories/')}
      moreLabel="全部分类"
    >
      <HomeExplore categoryCounts={categoryCounts} />
    </HomeSection>

    <!-- 4. 最近写的 -->
    <HomeSection
      id="writing"
      eyebrow="Writing"
      title="最近写的"
      moreHref={withBase('articles/')}
      moreLabel="全部文章"
    >
      <HomePosts posts={latest} />
    </HomeSection>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-9) var(--gutter) 0;
  }

  /* ---- 一句话 ----
   * Hero 之后的第一块。这里必须立刻安静下来：
   * 没有背景、没有边框，只有一段稍大的文字和大量留白。 */
  .intro {
    max-width: var(--measure-prose);
    margin-bottom: var(--space-9);
  }

  .intro__lead {
    margin: 0 0 var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--ink);
    text-wrap: balance;
  }

  .intro__lead strong {
    font-weight: 500;
  }

  .intro__more {
    margin: 0;
    font-size: var(--text-base);
  }

  .intro__more a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .intro__more a:hover {
    color: var(--accent-ink);
  }
</style>
