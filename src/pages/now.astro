---
/**
 * /now —— 此刻在做什么。
 *
 * 和 About 的区别：About 是"我是谁"，Now 是"我现在在忙什么"。
 * 内容过时了就直接改，不留档 —— 这正是它有意义的地方。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { now, lastUpdated } from '../data/now';
import { withBase } from '../utils/url';

const updated = new Date(lastUpdated);
---

<BaseLayout
  title="Now"
  description="此刻在做的事 —— 在学什么、在做什么、在读什么。"
  path="now/"
  weather="day"
>
  <PageHero eyebrow="Now" title="现在" description={now.intro} weather="day" />

  <div class="now">
    <ul class="doing">
      {
        now.doing.map((item) => (
          <li class="doing__item">
            <span class="doing__label">{item.label}</span>
            <p class="doing__text">{item.text}</p>
          </li>
        ))
      }
    </ul>

    <section class="section">
      <h2 class="section__title">关注的几个方向</h2>
      <ul class="chips">
        {now.focus.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <section class="section">
      <h2 class="section__title">这个博客接下来想补的</h2>
      <ul class="roadmap">
        {now.roadmap.map((r) => <li>{r}</li>)}
      </ul>
    </section>

    <p class="updated">
      最后更新于
      <time datetime={lastUpdated}>
        {updated.getFullYear()} 年 {updated.getMonth() + 1} 月 {updated.getDate()} 日
      </time>
      。这一页会随时改。想看更稳定的东西，去
      <a href={withBase('about/')}>关于</a>。
    </p>
  </div>
</BaseLayout>

<style>
  .now {
    max-width: 56rem;
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) 0;
  }

  .doing {
    margin: 0 0 var(--space-9);
    padding: 0;
    list-style: none;
  }

  .doing__item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .doing__item:first-child {
    padding-top: 0;
  }

  .doing__label {
    font-size: var(--text-sm);
    color: var(--ink-subtle);
    padding-top: 0.2em;
  }

  .doing__text {
    margin: 0;
    max-width: 40em;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--ink);
  }

  .section {
    margin-bottom: var(--space-8);
  }

  .section__title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.25em 0.75em;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    border: var(--border-hairline) solid var(--rule);
    border-radius: var(--radius-sm);
  }

  .roadmap {
    margin: 0;
    padding-left: 1.4em;
    max-width: 40em;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--ink-muted);
  }

  .roadmap li {
    margin-bottom: var(--space-2);
  }

  .updated {
    margin: 0;
    padding-top: var(--space-5);
    border-top: var(--border-hairline) solid var(--rule);
    max-width: 40em;
    font-size: var(--text-sm);
    color: var(--ink-subtle);
    line-height: var(--leading-normal);
  }

  .updated a {
    color: var(--ink-muted);
  }
</style>
