---
/**
 * 关于。
 *
 * 这是**博客介绍**，不是简历。
 * 有意去掉了技术栈、技能档位、学习时间线那一套 ——
 * 「PWN 73%」这种数字是编出来的，没有信息量，写死就会过期。
 *
 * 页面只讲三件事：这是什么地方、会写什么、怎么联系。
 * 「会写什么」直接来自分类表（src/config/taxonomy.ts），
 * 新增分类时这里会自动更新，不需要改本文件。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { site } from '../config/site';
import { intro, writingNote, footnote } from '../data/about';
import { categories } from '../config/taxonomy';
import { getPosts, collectCategories } from '../utils/posts';
import { withBase } from '../utils/url';

const posts = await getPosts();
const counts = collectCategories(posts);
---

<BaseLayout
  title="关于"
  description={`关于 ${site.title} —— 这个博客是什么，会写些什么。`}
  path="about/"
  weather="dusk"
>
  <PageHero eyebrow="About" title="关于" description={site.description} />

  <div class="about">
    <!-- 博客介绍 -->
    <section class="section">
      <h2 class="section__title">{site.title}</h2>
      <div class="prose-block">
        {intro.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <!-- 会写什么：直接来自分类表 -->
    <section class="section">
      <h2 class="section__title">会写什么</h2>
      <p class="section__note">{writingNote}</p>

      <ul class="cats">
        {
          categories.map((cat) => {
            const count = counts.get(cat.name)?.length ?? 0;
            return (
              <li class="cat">
                <a class="cat__link" href={withBase(`categories/${cat.slug}/`)}>
                  <span class="cat__head">
                    <span class="cat__name">{cat.name}</span>
                    {count > 0 && <span class="cat__count">{count} 篇</span>}
                  </span>
                  <span class="cat__desc">{cat.description}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- 联系方式 -->
    <section class="section">
      <h2 class="section__title">在这里之外</h2>
      <ul class="links">
        {
          site.social.map((link) => (
            <li>
              <a href={link.href} rel="me noopener noreferrer" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase('rss.xml')}>RSS 订阅</a>
        </li>
        <li>
          <a href={withBase('archive/')}>全部文章</a>
        </li>
      </ul>
    </section>

    <p class="footnote">{footnote}</p>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 56rem;
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) 0;
  }

  .section {
    margin-bottom: var(--space-9);
  }

  .section__title {
    margin: 0 0 var(--space-5);
    font-size: var(--text-2xl);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .section__note {
    margin: calc(var(--space-5) * -1 + var(--space-1)) 0 var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-subtle);
  }

  /* ---- 介绍正文 ---- */

  .prose-block {
    max-width: var(--measure-prose);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--ink-muted);
  }

  .prose-block p {
    margin: 0 0 1.1em;
  }

  .prose-block p:first-child {
    color: var(--ink);
  }

  .prose-block p:last-child {
    margin-bottom: 0;
  }

  /* ---- 分类列表 ----
   * 用条目而不是卡片网格：卡片会逼着每条都配图或撑满高度，反而显得空。
   * 一条发丝线分隔 + 左侧标题右侧计数，就是"编辑感"的做法。 */

  .cats {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure-wide);
  }

  .cat {
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .cat:first-child {
    border-top: var(--border-hairline) solid var(--rule);
  }

  .cat__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    text-decoration: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .cat__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .cat__name {
    font-size: var(--text-xl);
    color: var(--ink);
    line-height: var(--leading-snug);
  }

  .cat__link:hover .cat__name {
    color: var(--accent-ink);
  }

  .cat__count {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    font-variant-numeric: tabular-nums;
  }

  .cat__desc {
    max-width: 40em;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-muted);
  }

  /* ---- 链接 ---- */

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-base);
  }

  .links a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  /* ---- 页尾 ---- */

  .footnote {
    margin: 0;
    padding-top: var(--space-5);
    border-top: var(--border-hairline) solid var(--rule);
    max-width: var(--measure-prose);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-subtle);
  }
</style>
