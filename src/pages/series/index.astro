---
/**
 * 系列总览。
 *
 * 这一页是「成长记录」定位最重要的支点：
 * 分类是横切（这篇属于哪一类），系列是纵深（这篇在成长线上的第几站）。
 * 读者在这里能看到的不是"我又写了什么"，而是"我一路是怎么走过来的"。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getPosts, collectSeries, readingTime } from '../../utils/posts';
import { withBase } from '../../utils/url';

const posts = await getPosts();
const series = [...collectSeries(posts).entries()];
---

<BaseLayout title="系列" description="按系列阅读 —— 一条条完整的学习路径。" path="series/">
  <PageHero
    eyebrow="Series"
    title="系列"
    description="单篇文章是片段，系列才是一条完整的路。"
  />

  <div class="listing">
    {
      series.length === 0 ? (
        <p class="empty">
          还没有系列。在文章的 frontmatter 里加上 <code>series</code> 字段即可归入系列。
        </p>
      ) : (
        series.map(([name, list]) => (
          <section class="series">
            <header class="series__head">
              <h2 class="series__name">
                <a href={withBase(`series/${encodeURIComponent(name)}/`)}>{name}</a>
              </h2>
              <p class="series__meta">
                {list.length} 篇 · 约 {list.reduce((sum, p) => sum + readingTime(p.body), 0)} 分钟
              </p>
            </header>

            <ol class="series__list">
              {list.map((post) => (
                <li>
                  <a href={withBase(`articles/${post.id}/`)}>{post.data.title}</a>
                  {post.data.description && (
                    <span class="series__desc">{post.data.description}</span>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>

<style>
  .listing {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) 0;
    max-width: 60rem;
  }

  .listing {
    max-width: 60rem;
  }

  .series {
    margin-bottom: var(--space-9);
    padding-bottom: var(--space-7);
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .series:last-child {
    border-bottom: none;
  }

  .series__head {
    margin-bottom: var(--space-5);
  }

  .series__name {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
  }

  .series__name a {
    color: var(--ink);
    text-decoration: none;
  }

  .series__name a:hover {
    color: var(--accent-ink);
  }

  .series__meta {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-subtle);
    font-variant-numeric: tabular-nums;
  }

  .series__list {
    margin: 0;
    padding-left: 1.4em;
    counter-reset: none;
  }

  .series__list li {
    margin-bottom: var(--space-4);
  }

  .series__list a {
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-lg);
  }

  .series__list a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  .series__desc {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--leading-normal);
    max-width: 40em;
  }

  .empty {
    color: var(--ink-muted);
    max-width: var(--measure-prose);
  }

  .empty code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.12em 0.4em;
    background: var(--code-surface);
    border: var(--border-hairline) solid var(--code-rule);
    border-radius: var(--radius-sm);
  }
</style>
