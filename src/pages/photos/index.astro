---
/**
 * 图片分享。
 *
 * 定位是「偶尔分享一些喜欢的图片」，不是图片社区 ——
 * 所以没有瀑布流、没有 masonry 库、没有悬浮遮罩和发光。
 * 就是把图安静地排在纸上：一张图，底下一行日期与标题，仅此而已。
 *
 * 排版用**等高网格**而不是瀑布流：
 *   瀑布流需要 JS 计算高度（或者列布局），并且会让"第几张图"这件事消失。
 *   统一 3:2 裁切之后，每张图在版面上权重相同，滚动时节奏稳定，
 *   也不会出现某张图被拉得特别长的情况。图少了更是明显更整齐。
 *
 * 点击放大用原生 <dialog>：浏览器自带焦点陷阱、ESC 关闭、背景遮罩，
 * 不需要任何库，脚本只有二十来行。
 *
 * 图片走 astro:assets：构建期生成多档尺寸的 srcset 与 webp，
 * 访客不会为了看一眼缩略图而下整张原图。
 *
 * ⚠️ 首页不引用这里的任何图片 —— 图片页不该拖慢首屏。
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getCollection } from 'astro:content';
import { formatDate, isoDate } from '../../utils/date';

const entries = (await getCollection('photos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 放大用的版本单独生成一档，避免灯箱直接甩出原图
const photos = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    large: (await getImage({ src: entry.data.image, width: 1600, format: 'webp' })).src,
  }))
);
---

<BaseLayout
  title="图片"
  description="偶尔拍到的、或者恰好看到的。"
  path="photos/"
  weather="dusk"
>
  <PageHero eyebrow="Photos" title="图片" description="偶尔拍到的、或者恰好看到的。" />

  <div class="gallery">
    {
      photos.length === 0 ? (
        <div class="empty">
          <p class="empty__title">这里还没有图片。</p>
          <p class="empty__body">
            把图片放进 <code>src/content/photos/</code>，
            再写一个同名 <code>.md</code> 填好 frontmatter，它就会出现在这里。
          </p>
        </div>
      ) : (
        <ul class="grid">
          {photos.map(({ entry, large }, index) => {
            const { data } = entry;
            const alt = data.alt ?? data.title;
            /* 前几张（大约一屏）用 eager：它们本来就在视口里，
               用 lazy 只会让首屏先空一块再"啪"地补上。
               其余交给浏览器按需加载 —— 图片页图多了以后这是必需的。 */
            const eager = index < 3;
            return (
              <li class="item">
                <button
                  class="item__open"
                  type="button"
                  data-photo
                  data-src={large}
                  data-title={data.title}
                  data-desc={data.description}
                  data-alt={alt}
                  data-date={formatDate(data.date)}
                  aria-label={`放大查看：${data.title}`}
                >
                  <Image
                    src={data.image}
                    alt={alt}
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 46vw, 30vw"
                    loading={eager ? 'eager' : 'lazy'}
                    fetchpriority={eager ? 'high' : 'auto'}
                    decoding="async"
                    class="item__img"
                  />
                </button>

                <div class="item__meta">
                  <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
                  <h2 class="item__title">{data.title}</h2>
                  <p class="item__desc">{data.description}</p>

                  {data.tags.length > 0 && (
                    <ul class="item__tags">
                      {data.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>

  <dialog class="lightbox" id="photo-lightbox" aria-label="查看大图">
    <form method="dialog" class="lightbox__bar">
      <button class="lightbox__close" type="submit" aria-label="关闭">×</button>
    </form>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__caption">
        <time class="lightbox__date"></time>
        <h2 class="lightbox__title"></h2>
        <p class="lightbox__desc"></p>
      </figcaption>
    </figure>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img');
    const dateEl = dialog.querySelector<HTMLElement>('.lightbox__date');
    const titleEl = dialog.querySelector<HTMLElement>('.lightbox__title');
    const descEl = dialog.querySelector<HTMLElement>('.lightbox__desc');

    for (const btn of document.querySelectorAll<HTMLElement>('[data-photo]')) {
      btn.addEventListener('click', () => {
        const { src, title, desc, alt, date } = btn.dataset;
        if (img) {
          img.src = src ?? '';
          img.alt = alt ?? '';
        }
        if (titleEl) titleEl.textContent = title ?? '';
        if (descEl) descEl.textContent = desc ?? '';
        if (dateEl) dateEl.textContent = date ?? '';

        // 极老的浏览器没有 showModal：退化成直接打开图片，而不是什么都不发生
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else if (src) window.open(src, '_blank', 'noopener');
      });
    }

    // 点遮罩关闭。判定事件目标就是 dialog 本身 ——
    // 点内容区时 target 会是里面的元素。
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .gallery {
    max-width: 68rem;
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) 0;
  }

  /* 等高网格。用 minmax 让列数随宽度自然变化，
     不写死断点 —— 图片页的列数本来就该跟着图片尺寸走。 */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-7) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* 图片本体：统一 3:2，避免不同比例的图把网格撑得参差 */
  .item__open {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-md);
    overflow: hidden;
    /* 轻微的悬浮反馈，克制到几乎察觉不到 */
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .item__open:hover {
    opacity: 0.88;
  }

  .item__open :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .item__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .item__meta time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    font-variant-numeric: tabular-nums;
  }

  .item__title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ink);
  }

  .item__desc {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-muted);
  }

  .item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }

  .item__tags li::before {
    content: '#';
    opacity: 0.5;
    margin-right: 0.15em;
  }

  /* ---- 空状态 ---- */

  .empty {
    max-width: var(--measure-prose);
  }

  .empty__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    color: var(--ink);
  }

  .empty__body {
    margin: 0;
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
  }

  .empty code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.12em 0.4em;
    background: var(--code-surface);
    border: var(--border-hairline) solid var(--code-rule);
    border-radius: var(--radius-sm);
  }

  /* ---- 灯箱 ----
   * 用原生 <dialog>：焦点陷阱、ESC 关闭、背景遮罩都是浏览器给的。
   * 这里只做视觉 —— 深色底、居中、克制的圆角。 */

  .lightbox {
    max-width: min(92vw, 72rem);
    max-height: 92svh;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: color-mix(in oklab, oklch(0.12 0.02 265) 88%, transparent);
    backdrop-filter: blur(2px);
  }

  .lightbox__bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-2);
  }

  .lightbox__close {
    width: 2rem;
    height: 2rem;
    font-size: 1.25rem;
    line-height: 1;
    color: oklch(0.9 0.01 250);
    background: color-mix(in oklab, oklch(0.12 0.02 265) 55%, transparent);
    border: var(--border-hairline) solid color-mix(in oklab, oklch(0.9 0.01 250) 24%, transparent);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .lightbox__close:hover {
    border-color: color-mix(in oklab, oklch(0.9 0.01 250) 55%, transparent);
  }

  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .lightbox__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 76svh;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .lightbox__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in oklab, oklch(0.14 0.02 265) 88%, transparent);
    border-radius: var(--radius-md);
  }

  .lightbox__caption time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: oklch(0.72 0.012 255);
  }

  .lightbox__title {
    margin: 0;
    font-size: var(--text-lg);
    color: oklch(0.95 0.008 250);
  }

  .lightbox__desc {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: oklch(0.78 0.012 255);
  }
</style>
