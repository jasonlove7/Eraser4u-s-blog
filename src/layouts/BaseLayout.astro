---
/**
 * BaseLayout —— 全站骨架。
 *
 * 职责：
 *   1. 输出 <html> / <head>，接入 SEO 组件
 *   2. 挂载设计 token 与基础样式
 *   3. 设置天气（data-weather），驱动 tokens.css 里的天空原语
 *   4. 导航 + 页脚 + 跳到主内容
 *
 * 页头氛围层（AtmosphereHeader）由各页面放进默认插槽自己渲染 ——
 * 不放这里，是因为不同页面对氛围的用法差别很大：
 * 首页要占满首屏、并在 nav 之下，文章页只需要一条 30vh 的窄页头。
 */
import { site, type Weather } from '../config/site';
import SEO from '../components/seo/SEO.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

import '../styles/tokens.css';
import '../styles/base.css';

export interface Props {
  title?: string;
  description?: string;
  /** 页面天气氛围。默认取 site.theme.default */
  weather?: Weather;
  /** OG 类型 */
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** 当前页面站点根相对路径，用于 canonical */
  path?: string;
  /** 主内容区附加类名（如文章页需要更窄的版心） */
  mainClass?: string;
  /**
   * 导航顶部透明、滚动后淡入。
   * 仅用于首屏直接接氛围层的页面（目前是首页）——
   * 其他页面若开启，导航会压在正文上而失真可读性。
   */
  overlayHeader?: boolean;
}

const {
  title,
  description,
  weather = site.theme.default,
  type,
  image,
  publishedTime,
  modifiedTime,
  tags,
  noindex,
  path,
  mainClass = '',
  overlayHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang={site.lang} data-weather={weather} data-weather-default={weather}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={site.theme.accent} />

    {
      /* 天气防闪烁。
       *
       * 必须在 <head> 里、**首次绘制之前**同步执行：
       * 用户在页脚选了某个天气并存进 localStorage，
       * 如果等到页脚脚本（DOM 末尾）才应用，页面会先按默认天气画一帧，
       * 然后"啪"地跳到另一个配色 —— 非常刺眼。
       *
       * is:inline 让 Astro 原样输出、不打包不延迟。
       * 体积极小（约 200 字节），且只在本地有覆盖时才做事。 */
    }
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          // ?w=rain 之类的查询参数：**只影响这一次浏览**，不写入 localStorage。
          // 用途是分享一个特定氛围的链接，以及调试时逐一切换天气看效果。
          // 它也优先于本地保存的偏好 —— 否则想看某一页的雨天会被自己的设置挡住。
          var q = new URLSearchParams(location.search).get('w');
          if (q) {
            d.setAttribute('data-weather', q);
            d.setAttribute('data-weather-query', '');
            return;
          }
          var v = localStorage.getItem('eraser4u-weather');
          if (v) {
            d.setAttribute('data-weather', v);
            d.setAttribute('data-weather-mode', 'manual');
          }
        } catch (e) {
          /* 隐私模式下 localStorage 可能抛异常：忽略，用页面自带的默认天气 */
        }
      })();
    </script>
    <SEO
      title={title}
      description={description}
      type={type}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noindex={noindex}
      path={path}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主内容</a>

    <SiteHeader overlay={overlayHeader} />

    {
      /* data-pagefind-body 显式限定搜索索引的范围。
         不写它的话，Pagefind 会退化成"整页都索引" ——
         导航、页脚、侧栏全被收进去，搜一个词命中一堆其实没这篇文章的页面。
         写在 <main> 上意味着：只索引正文区。 */
    }
    <main id="main" class={mainClass} data-pagefind-body>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
