---
/**
 * BaseLayout —— 全站骨架。
 *
 * 职责：
 *   1. 输出 <html> / <head>，接入 SEO 组件
 *   2. 挂载设计 token 与基础样式
 *   3. 设置天气（data-weather），驱动 tokens.css 里的天空原语
 *   4. 导航 + 页脚 + 跳到主内容
 *
 * 页头氛围层（AtmosphereHeader）由各页面放进默认插槽自己渲染 ——
 * 不放这里，是因为不同页面对氛围的用法差别很大：
 * 首页要占满首屏、并在 nav 之下，文章页只需要一条 30vh 的窄页头。
 */
import { site, type Weather } from '../config/site';
import SEO from '../components/seo/SEO.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

import '../styles/tokens.css';
import '../styles/base.css';

export interface Props {
  title?: string;
  description?: string;
  /** 页面天气氛围。默认取 site.theme.default */
  weather?: Weather;
  /** OG 类型 */
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** 当前页面站点根相对路径，用于 canonical */
  path?: string;
  /** 主内容区附加类名（如文章页需要更窄的版心） */
  mainClass?: string;
  /**
   * 导航顶部透明、滚动后淡入。
   * 仅用于首屏直接接氛围层的页面（目前是首页）——
   * 其他页面若开启，导航会压在正文上而失真可读性。
   */
  overlayHeader?: boolean;
}

const {
  title,
  description,
  weather = site.theme.default,
  type,
  image,
  publishedTime,
  modifiedTime,
  tags,
  noindex,
  path,
  mainClass = '',
  overlayHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang={site.lang} data-weather={weather}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={site.theme.accent} />
    <SEO
      title={title}
      description={description}
      type={type}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noindex={noindex}
      path={path}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主内容</a>

    <SiteHeader overlay={overlayHeader} />

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
