---
/**
 * 城市天际线 —— 原创 SVG 剪影，四层景深。
 *
 * 视觉方向是**现代东亚都市**：高层住宅塔楼、玻璃幕墙写字楼、裙楼，
 * 以及少量明显高出天际线一座头的地标塔。全是手写的几何与确定性生成的
 * 体块，不含任何真实城市照片或第三方素材。
 *
 * ── 两个关键工程决定 ─────────────────────────────────────────────
 *
 * 1) 景深来自**四层**，不是把建筑排在同一个平面上：
 *      distant → 几乎融进天空，只留一层高低起伏的轮廓
 *      far     → 能看出是楼，但仍隔着一层空气
 *      mid     → 主体。写字楼、住宅塔、地标塔都在这一层
 *      near    → 最靠近镜头：宽而低的屋顶，带围栏、水箱、设备
 *    每层的颜色都往天空色混、加模糊、降不透明度 ——
 *    这是"大气透视"，也是本项目从头到尾替代 box-shadow 的层次手段。
 *
 * 2) 窗户用 **SVG <pattern>**，不是逐窗一个 <rect>。
 *    一栋 40 层的高层住宅有几百扇窗，四层楼群加起来会有几千个节点，
 *    首页 HTML 会从 44KB 涨到 150KB+，而且首屏渲染变慢。
 *    用 pattern 平铺后，每栋楼只需要 2 个 <rect>（实体 + 窗层），
 *    整页 DOM 减少一个数量级，视觉上仍然是一整片错落的灯火。
 */
export interface Props {
  depth?: 'distant' | 'far' | 'mid' | 'near';
}

const { depth = 'mid' } = Astro.props;

/** 基线：所有建筑从这里向上生长 */
const BASE = 360;

/**
 * 确定性伪随机。
 * 用固定种子而不是 Math.random —— 否则每次构建的城市轮廓都不一样，
 * 而且没法复现"上一版更好看"这件事。
 */
function makeRng(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (s * 1103515245 + 12345) >>> 0;
    return ((s >>> 16) & 0x7fff) / 0x7fff;
  };
}

type Kind = 'tower' | 'office' | 'podium' | 'landmark';

interface Building {
  x: number;
  w: number;
  h: number;
  kind: Kind;
  /** 桅杆 / 天线高度 */
  antenna?: number;
  /** 屋顶水箱 */
  tank?: boolean;
  /** 屋顶围栏 */
  rail?: boolean;
  /** 顶部梯级收进 */
  setback?: number;
}

interface LayerSpec {
  seed: number;
  /** 建筑宽度范围 */
  wRange: [number, number];
  /** 建筑高度范围 */
  hRange: [number, number];
  /** 出现高塔的概率 */
  towerChance: number;
  /** 塔楼高度范围 */
  towerRange: [number, number];
  /** 屋顶细部的概率 */
  detailChance: number;
}

const SPECS: Record<NonNullable<Props['depth']>, LayerSpec> = {
  distant: {
    seed: 20260901,
    wRange: [18, 46],
    hRange: [52, 132],
    towerChance: 0.1,
    towerRange: [150, 232],
    detailChance: 0.05,
  },
  far: {
    seed: 19980412,
    wRange: [22, 62],
    hRange: [66, 168],
    towerChance: 0.16,
    towerRange: [180, 268],
    detailChance: 0.12,
  },
  mid: {
    seed: 776621,
    wRange: [34, 104],
    hRange: [96, 218],
    towerChance: 0.22,
    towerRange: [232, 316],
    detailChance: 0.3,
  },
  near: {
    seed: 3141592,
    wRange: [104, 320],
    hRange: [48, 124],
    towerChance: 0.08,
    towerRange: [150, 210],
    detailChance: 0.85,
  },
};

const spec = SPECS[depth];
const rand = makeRng(spec.seed);

function buildLayer(): Building[] {
  const out: Building[] = [];
  let x = -40; // 从画外开始，避免左边缘出现突兀的直边

  while (x < 1480) {
    const isTower = rand() < spec.towerChance;
    const w = Math.round(
      spec.wRange[0] + rand() * (spec.wRange[1] - spec.wRange[0])
    );
    const h = isTower
      ? Math.round(spec.towerRange[0] + rand() * (spec.towerRange[1] - spec.towerRange[0]))
      : Math.round(spec.hRange[0] + rand() * (spec.hRange[1] - spec.hRange[0]));

    // 高层住宅塔楼：细高、接近方形截面
    const kind: Kind = isTower ? 'tower' : w > 92 ? 'office' : 'podium';

    const detail = rand() < spec.detailChance;
    const b: Building = { x, w, h, kind };

    if (kind === 'tower') {
      // 塔楼细部：顶部退台 + 桅杆
      if (rand() < 0.45) b.setback = Math.round(w * 0.22);
      if (rand() < 0.4) b.antenna = Math.round(14 + rand() * 34);
    } else if (kind === 'office') {
      if (detail && rand() < 0.5) b.antenna = Math.round(12 + rand() * 26);
      if (detail && rand() < 0.4) b.tank = true;
    } else {
      if (detail && rand() < 0.5) b.tank = true;
      if (detail && rand() < 0.6) b.rail = true;
    }

    out.push(b);
    // 楼与楼之间留一点缝，缝宽也随机 —— 等距会立刻暴露"程序生成"
    x += w + 2 + Math.round(rand() * 10);
  }

  return out;
}

const buildings = buildLayer();

/** 两座地标塔：只有 middle 与 far 层有，且位置固定，形成天际线的记忆点 */
const LANDMARKS: Building[] =
  depth === 'mid'
    ? [
        { x: 372, w: 44, h: 344, kind: 'landmark', antenna: 40 },
        { x: 1108, w: 52, h: 318, kind: 'landmark', antenna: 26 },
      ]
    : depth === 'far'
      ? [{ x: 890, w: 30, h: 262, kind: 'landmark', antenna: 22 }]
      : [];

const all = [...buildings, ...LANDMARKS];

const pid = `sky-${depth}`;
---

<div class="skyline" data-depth={depth} aria-hidden="true">
  <svg viewBox={`0 0 1440 ${BASE}`} preserveAspectRatio="xMidYMax slice" role="presentation">
    <defs>
      {/*
        窗灯图案。

        ⚠️ 关键设计：**瓷砖必须够大，且内部亮度不规则**。
        早先用 9×11 的小瓷砖、每个瓷砖一扇等亮的窗，
        平铺到一栋 300 高的塔楼上就变成一张均匀的方格纸 ——
        看起来像纹理贴图，而不是"有些楼层亮着、有些黑着"的城市。

        现在每块瓷砖里手工排十几扇窗，亮度从 0.2 到 1 各不相同，
        并且刻意留出空位（没开的窗 = 完全不画）。
        瓷砖一大，重复的周期就超出了肉眼在缩略图上的分辨能力，
        整体读起来就是错落的灯火。
      */}

      {/* 高层住宅塔楼：密集小窗，高低错落 */}
      <pattern id={`${pid}-tower`} width="46" height="38" patternUnits="userSpaceOnUse">
        <rect x="3" y="4" width="5" height="6" opacity="0.9" />
        <rect x="13" y="4" width="5" height="6" opacity="0.35" />
        <rect x="23" y="4" width="5" height="6" opacity="0.7" />
        <rect x="33" y="4" width="5" height="6" opacity="0.2" />
        <rect x="41" y="4" width="5" height="6" opacity="0.8" />
        <rect x="3" y="15" width="5" height="6" opacity="0.3" />
        <rect x="13" y="15" width="5" height="6" opacity="0.85" />
        <rect x="23" y="15" width="5" height="6" opacity="0.25" />
        <rect x="33" y="15" width="5" height="6" opacity="0.65" />
        <rect x="3" y="26" width="5" height="6" opacity="0.55" />
        <rect x="13" y="26" width="5" height="6" opacity="0.2" />
        <rect x="23" y="26" width="5" height="6" opacity="0.9" />
        <rect x="33" y="26" width="5" height="6" opacity="0.4" />
        <rect x="41" y="26" width="5" height="6" opacity="0.25" />
        <rect x="3" y="36" width="5" height="6" opacity="0.45" />
        <rect x="23" y="36" width="5" height="6" opacity="0.3" />
        <rect x="33" y="36" width="5" height="6" opacity="0.75" />
      </pattern>

      {/* 写字楼：整层通窗的横带，逐层亮暗不同 */}
      <pattern id={`${pid}-office`} width="60" height="33" patternUnits="userSpaceOnUse">
        <rect x="0" y="4" width="52" height="6" opacity="0.8" />
        <rect x="8" y="15" width="44" height="6" opacity="0.35" />
        <rect x="0" y="26" width="30" height="6" opacity="0.65" />
        <rect x="36" y="26" width="20" height="6" opacity="0.4" />
      </pattern>

      {/* 玻璃幕墙：竖明横隐的格线，隔几层有一条亮的办公层 */}
      <pattern id={`${pid}-glass`} width="26" height="30" patternUnits="userSpaceOnUse">
        <rect x="0" y="0" width="1" height="30" opacity="0.3" />
        <rect x="13" y="0" width="1" height="30" opacity="0.22" />
        <rect x="0" y="0" width="26" height="1" opacity="0.26" />
        <rect x="0" y="15" width="26" height="1" opacity="0.2" />
        <rect x="3" y="7" width="20" height="5" opacity="0.5" />
      </pattern>

      {/* 地标塔：更亮更密的办公层 —— 它在天际线上应该是最显眼的 */}
      <pattern id={`${pid}-landmark`} width="54" height="26" patternUnits="userSpaceOnUse">
        <rect x="0" y="3" width="46" height="6" opacity="0.85" />
        <rect x="6" y="12" width="40" height="5" opacity="0.5" />
        <rect x="0" y="20" width="28" height="5" opacity="0.7" />
      </pattern>

      {/* 裙楼：稀疏的大窗，间距也拉大 */}
      <pattern id={`${pid}-podium`} width="76" height="58" patternUnits="userSpaceOnUse">
        <rect x="10" y="12" width="16" height="12" opacity="0.5" />
        <rect x="42" y="12" width="14" height="12" opacity="0.25" />
        <rect x="24" y="36" width="18" height="12" opacity="0.6" />
        <rect x="56" y="36" width="12" height="12" opacity="0.3" />
      </pattern>
    </defs>

    <!-- 建筑实体（深色剪影） -->
    <g class="skyline__mass">
      {
        all.map((b) => (
          <g>
            <rect x={b.x} y={BASE - b.h} width={b.w} height={b.h} />
            {b.setback ? (
              <rect
                x={b.x + b.setback! * 0.5}
                y={BASE - b.h - 16}
                width={b.w - b.setback!}
                height="16"
              />
            ) : null}
            {b.antenna ? (
              <rect x={b.x + b.w * 0.5 - 1.5} y={BASE - b.h - b.antenna!} width="3" height={b.antenna!} />
            ) : null}
            {b.tank ? (
              <g>
                <rect x={b.x + b.w * 0.6} y={BASE - b.h - 14} width="18" height="11" />
                <rect x={b.x + b.w * 0.62} y={BASE - b.h - 4} width="3" height="4" />
                <rect x={b.x + b.w * 0.6 + 12} y={BASE - b.h - 4} width="3" height="4" />
              </g>
            ) : null}
            {b.rail ? (
              <rect x={b.x} y={BASE - b.h - 5} width={b.w} height="5" />
            ) : null}
          </g>
        ))
      }

      {/* 地标塔的收顶：一个梯形冠 + 桅杆 */}
      {
        LANDMARKS.map((b) => (
          <path
            d={`M ${b.x + b.w * 0.16} ${BASE - b.h}
                L ${b.x + b.w * 0.34} ${BASE - b.h - 26}
                L ${b.x + b.w * 0.66} ${BASE - b.h - 26}
                L ${b.x + b.w * 0.84} ${BASE - b.h} Z`}
          />
        ))
      }
    </g>

    <!-- 窗灯层：用 pattern 平铺，头顶叠加在实体上 -->
    <g class="skyline__lights">
      {
        all.map((b) => (
          <rect
            class={`win win--${b.kind}`}
            x={b.x}
            y={BASE - b.h}
            width={b.w}
            height={b.h}
            fill={`url(#${pid}-${
              b.kind === 'tower'
                ? 'tower'
                : b.kind === 'office'
                  ? 'glass'
                  : b.kind === 'landmark'
                    ? 'landmark'
                    : 'podium'
            })`}
          />
        ))
      }
    </g>
  </svg>
</div>

<style>
  .skyline {
    /* 城市贴着容器底边，高度由宽度驱动 ——
       这样在首屏（900px 高）和窄页头（270px 高）里，
       楼的绝对尺寸一致，不会因为容器变高而被拉伸成巨物。 */
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
  }

  .skyline svg {
    display: block;
    width: 100%;
    height: var(--skyline-height);
    /* pattern 里的 currentColor 由此处接管 */
    color: var(--luminary);
  }

  .skyline__mass {
    fill: var(--skyline-ink);
  }

  .skyline__lights {
    /* 窗灯总强度由天气控制：白昼几乎不开灯，黄昏与雨夜最亮 */
    opacity: var(--window-opacity, 0);
  }

  /* 不同建筑类型的灯密度与亮度不同 ——
     全部一样亮会变成一片均匀的噪点，失去城市感。
     数值比早先压低了一些：图案内部已经有了亮暗层次，
     再叠一层高不透明度会重新糊成一张网格。 */
  .win--tower {
    opacity: 0.4;
  }

  .win--office {
    opacity: 0.32;
  }

  .win--podium {
    opacity: 0.2;
  }

  .win--landmark {
    opacity: 0.48;
  }

  /* 近景是几乎全黑的前景剪影，灯只该零星几点。
     早先它和最远处一样亮，前景就"跳"了出来，纵深反而没了。 */
  .skyline[data-depth='near'] .skyline__lights {
    opacity: calc(var(--window-opacity, 0) * 0.32);
  }

  /* ---- 大气透视：逐层向天空色混合、降低对比、增加模糊 ---- */

  /* 最远：只剩一层高低起伏的轮廓，楼与楼之间几乎连成一片 */
  .skyline[data-depth='distant'] {
    --skyline-ink: color-mix(in oklab, var(--sky-horizon) 84%, var(--ground));
    filter: blur(3px);
    opacity: 0.5;
  }

  /* 远：能看出是楼，但仍隔着空气 */
  .skyline[data-depth='far'] {
    --skyline-ink: color-mix(in oklab, var(--sky-horizon) 62%, var(--ground));
    filter: blur(1.8px);
    opacity: 0.72;
  }

  /* 中：主体层。能看清体块与窗格 */
  .skyline[data-depth='mid'] {
    --skyline-ink: color-mix(in oklab, var(--sky-horizon) 26%, var(--ground));
    filter: blur(0.7px);
    opacity: 0.94;
  }

  /* 近：完全压暗成前景剪影，不模糊 —— 这是"摄影"而不是"贴纸" */
  .skyline[data-depth='near'] {
    --skyline-ink: var(--atmo-foreground);
    opacity: 1;
  }

  /* 远处的灯更淡（中间隔了更多空气），近处更清楚 */
  .skyline[data-depth='distant'] .skyline__lights {
    opacity: calc(var(--window-opacity, 0) * 0.45);
  }

  .skyline[data-depth='far'] .skyline__lights {
    opacity: calc(var(--window-opacity, 0) * 0.7);
  }

  @media (max-width: 48rem) {
    /* 手机上模糊代价高、收益低：远层去掉，中层锐化 */
    .skyline[data-depth='distant'] {
      display: none;
    }

    .skyline[data-depth='far'] {
      filter: none;
    }

    .skyline[data-depth='mid'] {
      filter: none;
    }
  }
</style>
