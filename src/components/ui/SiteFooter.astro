---
/**
 * 站点页脚。
 * 收尾克制：一行签名 + 必要链接，不做大色块、不做多列导航。
 */
import { site } from '../../config/site';
import { withBase } from '../../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__signature">{site.author.signature}</p>

    <nav class="site-footer__links" aria-label="页脚导航">
      {
        site.social.map((link) => (
          <a href={link.href} rel="me noopener noreferrer" target="_blank">
            {link.label}
          </a>
        ))
      }
      <a href={withBase('rss.xml')}>RSS</a>
      <a href={withBase('about/')}>关于</a>
    </nav>

    <p class="site-footer__meta">
      <span>© {year} {site.author.name}</span>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <span>{site.footer.note}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: var(--border-hairline) solid var(--rule);
  }

  .site-footer__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-7) var(--gutter) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__signature {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }

  .site-footer__links a {
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-footer__links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--ink-subtle);
  }

  .site-footer__sep {
    opacity: 0.6;
  }
</style>
