---
/**
 * Hero —— 首页的「电影开场」。
 *
 * 排版按电影片头字幕的逻辑组织：
 *   一行小字（片名）→ 一个大字（名字）→ 一句签名（副题）→ 一条方向清单
 * 字号差距拉得很大，中间留大量空白 —— 这是"开场"而不是"网页标题"。
 *
 * ⚠️ 内容全部来自 src/data/hero.ts，这个组件里**没有一句硬编码的文案**。
 *
 * 标语轮播的实现：**纯 CSS，零 JavaScript**。
 *   把每句按顺序放进同一个网格单元（grid-area: 1/1），容器高度自动取最高的一句；
 *   每句跑同一个关键帧动画，只是 animation-delay 依次错开一个间隔。
 *   于是同一时刻只有一句处于不透明状态，形成柔和的交叉淡入淡出。
 *   句数在构建期就知道，因此关键帧里的百分比是算出来写死的 ——
 *   增删句子不需要改这个文件，重新构建即可。
 *
 *   ⚠️ 只有一句时不生成动画：轮播一句没有意义，而且会平白引入闪烁。
 */
import { site } from '../../config/site';
import { topics, quotes, QUOTE_INTERVAL_SECONDS } from '../../data/hero';
import WeatherSwitcher from '../ui/WeatherSwitcher.astro';

/** 过滤掉空行，避免配置里多敲一个回车就出现一次空白 */
const list = quotes.map((q) => q.trim()).filter(Boolean);

const count = list.length;
const interval = QUOTE_INTERVAL_SECONDS;
const cycle = count * interval;

/** 每句占据整个周期的百分比 */
const slot = count > 1 ? 100 / count : 100;
/** 淡入很短、淡出提前收尾，中间留出足够的静止阅读时间 */
const fadeInAt = Math.min(2.5, slot * 0.12);
const holdEndAt = slot * 0.82;

const animated = count > 1;
---

<section class="hero">
  {
    /* 主天气切换器：放在标题**上方**、天空区域内。
       切换后背景当场就变，不必滚到页脚 ——
       但尺寸做得极小，且不进任何视觉焦点，只是"顺手能按到"。
       放在标题之前而不是绝对定位，是为了让它天然跟随文字块，
       不会在窄屏上飘到云或城市的上面去。 */
  }
  <WeatherSwitcher variant="hero" />

  <p class="hero__eyebrow">{site.title}</p>

  <h1 class="hero__title">{site.author.handle}</h1>

  {
    count > 0 && (
      <div
        class="hero__quotes"
        data-animated={animated ? '' : undefined}
        style={animated ? `--cycle: ${cycle}s; --interval: ${interval}s` : undefined}
      >
        {list.map((quote, i) => (
          <p class="hero__quote" style={animated ? `--i: ${i}` : undefined}>
            {quote}
          </p>
        ))}
      </div>
    )
  }

  {
    topics.length > 0 && (
      <ul class="hero__topics">
        {topics.map((topic) => (
          <li>{topic}</li>
        ))}
      </ul>
    )
  }
</section>

{
  animated && (
    <style is:global set:html={`
@keyframes hero-quote-cycle {
  0% { opacity: 0; }
  ${fadeInAt.toFixed(3)}% { opacity: 1; }
  ${holdEndAt.toFixed(3)}% { opacity: 1; }
  ${slot.toFixed(3)}% { opacity: 0; }
  100% { opacity: 0; }
}
`} />
  )
}

<style>
  .hero {
    position: relative;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: 0 var(--gutter);
    color: var(--ink-on-scrim);
  }

  /* 文字背后的一层柔和暗晕。
   *
   * 为什么需要它：云的位置随视口变化，总会有某朵云正好飘到标题后面 ——
   * 白字压在浅色云上，对比度会掉到不可接受。
   * 与其去微调云的位置（换个屏幕宽度就又对不上了），
   * 不如在文字背后固定加一层很轻的径向压暗，把对比度"锁住"。
   * 它必须非常柔和，否则会变成一个明显的灰色污渍。 */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -3rem -4rem -2rem -4rem;
    pointer-events: none;
    background: radial-gradient(
      ellipse 68% 62% at 26% 46%,
      color-mix(in oklab, var(--scrim) 62%, transparent) 0%,
      color-mix(in oklab, var(--scrim) 30%, transparent) 45%,
      transparent 78%
    );
  }

  /* 片名：小字距拉开，像片头的制作方署名 */
  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-on-scrim-muted);
  }

  /* 名字：整页最大的字，字距收紧，行高压到 1 以内 */
  .hero__title {
    margin: 0;
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.03em;
    color: var(--ink-on-scrim);
    /* 名字压在天空上，给一层极轻的暗影让它在最亮的橙云上也站得住。
       注意：这是文字可读性措施，不是"发光文字"效果。 */
    text-shadow: 0 1px 24px color-mix(in oklab, var(--scrim) 55%, transparent);
  }

  /* ---- 标语轮播 ----
   * 用一个网格单元叠放所有句子：
   * 容器高度自动等于最高的一句，切换时**不会引起布局跳动**。 */
  .hero__quotes {
    display: grid;
    margin-top: var(--space-5);
    max-width: 26em;
  }

  /* 标语：衬线体，与名字形成对比 —— 一个现代、一个古典。
   *
   * 颜色用 --ink-on-scrim（近白）而不是 muted 那档：
   * 衬线体笔画更细，同样的浅灰压在明亮天空上会明显比无衬线体更虚。
   * 窄屏雪天下尤其明显 —— 地平线附近接近纯白，浅灰直接糊掉。
   * 再加一层和标题同款的轻微暗影，跨天气都能站住。 */
  .hero__quote {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 1.4vw + 0.85rem, 1.4rem);
    line-height: var(--leading-snug);
    color: var(--ink-on-scrim);
    text-shadow: 0 1px 18px color-mix(in oklab, var(--scrim) 62%, transparent);
    text-wrap: balance;
    /* 默认隐藏；只有一句时由下面的规则显式显示 */
    opacity: 0;
  }

  /* 句数 > 1：交给动画驱动（关键帧由组件在构建期生成） */
  .hero__quotes[data-animated] .hero__quote {
    animation: hero-quote-cycle var(--cycle) linear infinite;
    animation-delay: calc(var(--i) * var(--interval));
    /* both：延迟期间也保持 0% 的状态，否则未轮到的句子会闪现 */
    animation-fill-mode: both;
    will-change: opacity;
  }

  /* 只有一句：静态显示，不做任何动画 */
  .hero__quotes:not([data-animated]) .hero__quote:first-child {
    opacity: 1;
  }

  /* 动效降级：停掉轮播，只显示第一句。
   *
   * ⚠️ 必须用 `animation: none !important`，不能只依赖 base.css 的全局降级。
   *    base.css 把时长压到 0.01ms 并设 iteration-count: 1 ——
   *    配上 fill-mode: both，动画会**瞬间跑到 100%（opacity: 0）并停在那里**，
   *    结果是所有句子全部消失，Hero 上留一片空白。
   *    这正是"动效降级写反了"最典型的翻车方式。 */
  @media (prefers-reduced-motion: reduce) {
    .hero__quote {
      animation: none !important;
      opacity: 0;
    }

    .hero__quote:first-child {
      opacity: 1;
    }
  }

  /* 方向清单：一条细线之上的小字，不抢戏。数量可变，自动换行。 */
  .hero__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-7) 0 0;
    padding: var(--space-4) 0 0;
    list-style: none;
    /* 必须限宽：不限宽的话这条 border-top 会横贯整个版心，
       在画面里读起来就是一条不知从哪来的横线。 */
    max-width: 40rem;
    border-top: 1px solid color-mix(in oklab, var(--ink-on-scrim) 22%, transparent);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--ink-on-scrim-muted);
  }

  .hero__topics li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    white-space: nowrap;
  }

  /* 用极小的间隔点分隔，而不是竖线或边框 —— 更安静 */
  .hero__topics li + li::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: var(--radius-pill);
    background: currentColor;
    opacity: 0.45;
    margin-right: var(--space-4);
  }

  @media (max-width: 48rem) {
    .hero__eyebrow {
      margin-bottom: var(--space-3);
    }

    .hero__topics {
      margin-top: var(--space-5);
      max-width: 100%;
    }

    /* 暗晕在窄屏上要收紧，否则会占掉大半个画面 */
    .hero::before {
      inset: -2rem -1.5rem -1.5rem -1.5rem;
      background: radial-gradient(
        ellipse 82% 58% at 34% 46%,
        color-mix(in oklab, var(--scrim) 58%, transparent) 0%,
        color-mix(in oklab, var(--scrim) 26%, transparent) 48%,
        transparent 80%
      );
    }
  }
</style>
