---
/**
 * 项目 / 学习轨迹。
 *
 * 这一块承担"一个大学生正在成长"的叙事。
 * 用时间线的形态，而不是成就列表 —— 成就列表只能证明结果，
 * 时间线能看出过程的形状。
 */
import { projects, timeline } from '../../data/growth';
import { withBase } from '../../utils/url';
import type { Post } from '../../utils/posts';

export interface Props {
  /** 用于把系列和文章关联起来 */
  seriesPosts?: Map<string, Post[]>;
}

const { seriesPosts } = Astro.props;

const series = seriesPosts ? [...seriesPosts.entries()] : [];
// 时间线在首页只露前两条，避免这里变成第二份 /about
const recentTimeline = timeline.slice(0, 2);
---

<div class="growth">
  {
    series.length > 0 && (
      <div class="growth__col">
        <h3 class="growth__label">系列</h3>
        <ul class="series">
          {series.map(([name, list]) => (
            <li>
              <a href={withBase(`series/${encodeURIComponent(name)}/`)}>
                <span class="series__name">{name}</span>
                <span class="series__count">{list.length} 篇</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    recentTimeline.length > 0 && (
      <div class="growth__col">
        <h3 class="growth__label">轨迹</h3>
        <ol class="timeline">
          {recentTimeline.map((entry) => (
            <li>
              <span class="timeline__when">{entry.when}</span>
              <span class="timeline__title">{entry.title}</span>
            </li>
          ))}
        </ol>
      </div>
    )
  }

  {
    projects.length > 0 && (
      <div class="growth__col">
        <h3 class="growth__label">项目</h3>
        <ul class="projects">
          {projects.slice(0, 3).map((p) => (
            <li>
              {p.href ? (
                <a href={p.href} rel="noopener noreferrer" target="_blank">
                  {p.name}
                </a>
              ) : (
                <span>{p.name}</span>
              )}
              <span class="projects__status">{p.status}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .growth {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .growth__label {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-subtle);
  }

  .series,
  .projects,
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series li,
  .projects li,
  .timeline li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: var(--border-hairline) solid var(--rule);
    font-size: var(--text-base);
  }

  .series li:last-child,
  .projects li:last-child,
  .timeline li:last-child {
    border-bottom: none;
  }

  .series a,
  .projects a {
    color: var(--ink);
    text-decoration: none;
    line-height: var(--leading-snug);
  }

  .series a:hover,
  .projects a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  .series__count,
  .projects__status,
  .timeline__when {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    white-space: nowrap;
  }

  .timeline li {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .timeline__title {
    color: var(--ink);
    line-height: var(--leading-snug);
  }
</style>
