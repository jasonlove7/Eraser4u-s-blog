---
/**
 * 首页的「分类 / 系列」区块。
 *
 * 取代了早先的「项目 / 学习轨迹」——
 * 这一块应该服务于**读文章**，而不是列成就。
 *
 * 分类列表直接来自 src/config/taxonomy.ts，新增分类时这里自动跟上。
 * 系列为空时整列不渲染，分类自动占满宽度。
 */
import { categories } from '../../config/taxonomy';
import { withBase } from '../../utils/url';
import type { Post } from '../../utils/posts';

export interface Props {
  /** 分类名 → 该分类下的文章 */
  categoryCounts: Map<string, Post[]>;
  /** 系列名 → 该系列下的文章（按系列内序号排好序） */
  series: [string, Post[]][];
}

const { categoryCounts, series } = Astro.props;
---

<div class="explore" data-has-series={series.length > 0 ? '' : undefined}>
  <div class="explore__col">
    <h3 class="explore__label">分类</h3>
    <ul class="cats">
      {
        categories.map((cat) => {
          const count = categoryCounts.get(cat.name)?.length ?? 0;
          return (
            <li>
              <a href={withBase(`categories/${cat.slug}/`)}>
                <span class="cats__name">{cat.name}</span>
                <span class="cats__count">{count > 0 ? `${count} 篇` : '—'}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  {
    series.length > 0 && (
      <div class="explore__col">
        <h3 class="explore__label">系列</h3>
        <ul class="series">
          {series.map(([name, list]) => (
            <li>
              <a href={withBase(`series/${encodeURIComponent(name)}/`)}>
                <span class="series__name">{name}</span>
                <span class="series__count">{list.length} 篇</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .explore {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 1fr);
  }

  /* 有系列时才分两栏；只有分类时让它占满，避免右侧留一大块空白 */
  .explore[data-has-series] {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .explore__label {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-subtle);
  }

  .cats,
  .series {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cats li,
  .series li {
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .cats li:last-child,
  .series li:last-child {
    border-bottom: none;
  }

  .cats a,
  .series a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    font-size: var(--text-base);
    text-decoration: none;
    line-height: var(--leading-snug);
  }

  .cats__name,
  .series__name {
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .cats a:hover .cats__name,
  .series a:hover .series__name {
    color: var(--accent-ink);
  }

  .cats__count,
  .series__count {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-subtle);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
