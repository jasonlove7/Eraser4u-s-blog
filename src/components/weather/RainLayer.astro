---
/**
 * 雨。
 *
 * ── 这一版为什么重做 ────────────────────────────────────────
 *
 * 上一版的做法是：一整片连续竖线 + 一条纵向 mask 把它切成等长的虚线段。
 * mask 是**一维**的（只沿纵向变化），所以同一层里每一列的雨滴
 * 长短、粗细、亮度、节奏完全一样 —— 视觉上就是一片平行线阵列。
 * 靠调 background-size、换三层速度都只能改变"纹理的移动方式"，
 * 改不了"每一滴雨本身长得都一样"这个根本问题。
 *
 * 这一版借鉴 SnowLayer 的思路（构建期用固定种子生成一批元素、
 * 每个元素尺寸/透明度/位置/速度都不同），但**生成的是雨滴而不是雪点**：
 *
 *   · 每个雨滴是一条独立绘制的短线，位置、长度、线宽、
 *     不透明度、倾角**逐个随机**
 *   · 这些雨滴被写进一张 SVG，作为 mask 平铺在图层上；
 *     底色用 background-color 取 --rain-streak（颜色仍归 token 管）
 *   · 雨滴在瓷砖边界做环绕复制，因此平铺后上下左右都看不出接缝
 *
 * 这样"同一水平线上有长有短、有粗有细、有明有暗"是**结构上**成立的，
 * 而不是靠三层不同速度叠出来的错觉。
 *
 * ── 速度差异 ───────────────────────────────────────────────
 *
 * 一张平铺的 mask 只能整体平移，所以"每一滴雨速度都不同"在
 * 纯 CSS 平铺里做不到。这里用 **5 层**各自不同的速度来覆盖这个区间：
 * 141 / 218 / 300 / 400 / 474 px·s⁻¹，跨度 3.4 倍。
 * 5 档速度 × 每层内部的形态差异，视觉上就是"雨有快有慢"。
 *
 * ── 性能 ───────────────────────────────────────────────────
 *
 * ⚠️ transform 放在 .rain__layer（不含任何 mask / filter），
 *    mask 与 background 放在里面静态的 .rain__cells 上。
 *    给**带动画的元素**加 mask 或 filter，浏览器就无法把它交给合成器，
 *    动画会退回主线程逐帧重绘 —— 表现就是掉帧。
 *    分离之后 transform 是纯合成操作。
 *
 * ── 无缝循环 ───────────────────────────────────────────────
 *
 * 位移距离**严格等于 mask 瓷砖的高度**，且雨滴在瓷砖四边做了环绕复制，
 * 因此循环首尾像素级重合。5 层的 duration 取不成整数比，
 * 永远不会同时回到起点，不会出现"整屏一起重新开始"。
 *
 * 雨只在 data-weather="rain" 时 display:block，其余天气下动画完全停止。
 */

/** 确定性伪随机：固定种子 → 每次构建结果一致，Git diff 可控 */
function makeRng(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (s * 1103515245 + 12345) >>> 0;
    return ((s >>> 16) & 0x7fff) / 0x7fff;
  };
}

/** 瓷砖宽度。宽于常见视口，平铺时几乎看不出横向重复。 */
const TILE_W = 1600;

interface LayerSpec {
  layer: number;
  /** 瓷砖高度 = 循环的位移距离 */
  tileH: number;
  /** 瓷砖内的雨滴数量 */
  count: number;
  /** 长度范围 */
  len: [number, number];
  /** 三档线宽：细 / 普通 / 稍粗 */
  widths: [number, number, number];
  /** 三档不透明度：淡 / 中 / 明显 */
  opacities: [number, number, number];
  /** 倾斜系数（dx = tilt × len）。整体保持轻微倾斜，只在小范围浮动。 */
  tilt: [number, number];
  /** 漂移一整个循环的秒数 */
  dur: number;
  /** 负的起手相位，避免各层同时出发 */
  delay: number;
  seed: number;
}

/**
 * 五层雨幕：由远及近，长度、粗细、亮度、速度同步递增。
 * duration 刻意取不成整数比的小数，让它们持续互相错开。
 */
const LAYERS: LayerSpec[] = [
  {
    layer: 1,
    tileH: 520,
    count: 280,
    len: [4, 11],
    widths: [0.7, 0.95, 1.25],
    opacities: [0.14, 0.26, 0.4],
    tilt: [0.045, 0.105],
    dur: 3.69,
    delay: -0.31,
    seed: 902107,
  },
  {
    layer: 2,
    tileH: 620,
    count: 235,
    len: [6, 16],
    widths: [0.85, 1.15, 1.5],
    opacities: [0.16, 0.3, 0.44],
    tilt: [0.048, 0.11],
    dur: 2.84,
    delay: -1.13,
    seed: 424291,
  },
  {
    layer: 3,
    tileH: 720,
    count: 195,
    len: [9, 22],
    widths: [1, 1.4, 1.8],
    opacities: [0.18, 0.32, 0.48],
    tilt: [0.05, 0.115],
    dur: 2.4,
    delay: -1.77,
    seed: 313377,
  },
  {
    layer: 4,
    tileH: 820,
    count: 145,
    len: [12, 30],
    widths: [1.2, 1.7, 2.2],
    opacities: [0.2, 0.35, 0.52],
    tilt: [0.052, 0.12],
    dur: 2.05,
    delay: -0.74,
    seed: 161803,
  },
  {
    layer: 5,
    tileH: 900,
    count: 100,
    len: [16, 40],
    widths: [1.4, 2, 2.6],
    opacities: [0.24, 0.4, 0.58],
    tilt: [0.055, 0.125],
    dur: 1.9,
    delay: -1.42,
    seed: 271828,
  },
];

/**
 * 生成一层的 mask，返回 base64 的 data URI。
 *
 * 雨滴按（线宽档 × 透明度档）分组，每组写成一条 <path> ——
 * 逐滴一个 <line> 会把 SVG 撑得很大，分组后段数不变但元素数少一个数量级。
 * 长度、位置、倾角仍然是逐滴的，不受分组影响。
 */
function buildMaskUri(spec: LayerSpec): string {
  const rng = makeRng(spec.seed);
  const groups = new Map<string, string[]>();

  /** 加权抽签：偏向低档位，让"稍粗/明显"的雨滴只是少数 */
  const pick = (weights: [number, number, number]) => {
    const r = rng();
    if (r < weights[0]) return 0;
    if (r < weights[0] + weights[1]) return 1;
    return 2;
  };

  for (let i = 0; i < spec.count; i++) {
    const len = spec.len[0] + rng() * (spec.len[1] - spec.len[0]);
    const wIdx = pick([0.45, 0.4, 0.15]);
    const oIdx = pick([0.4, 0.4, 0.2]);
    const tilt = spec.tilt[0] + rng() * (spec.tilt[1] - spec.tilt[0]);

    const x = rng() * TILE_W;
    const y = rng() * spec.tileH;
    const dx = tilt * len;

    // 四边环绕：把可能落在瓷砖外的副本也补上，
    // 平铺之后上下左右都接得上，看不到接缝。
    const segs: string[] = [];
    for (const sx of [-1, 0, 1]) {
      for (const sy of [-1, 0, 1]) {
        const ax = x + sx * TILE_W;
        const ay = y + sy * spec.tileH;
        const bx = ax + dx;
        const by = ay + len;
        // 与瓷砖有交集才画
        if (Math.max(ax, bx) < 0 || Math.min(ax, bx) > TILE_W) continue;
        if (Math.max(ay, by) < 0 || Math.min(ay, by) > spec.tileH) continue;
        /* 用逗号而不是空格分隔：SVG path 语法允许，且能大幅减少需要转义的字符 */
        segs.push(`M${Math.round(ax)},${Math.round(ay)}l${Math.round(bx - ax)},${Math.round(by - ay)}`);
      }
    }

    const key = `${wIdx}-${oIdx}`;
    const list = groups.get(key) ?? [];
    list.push(...segs);
    groups.set(key, list);
  }

  const paths = [...groups.entries()]
    .map(([key, segs]) => {
      const [wIdx, oIdx] = key.split('-').map(Number);
      const w = spec.widths[wIdx];
      const o = spec.opacities[oIdx];
      return `<path d="${segs.join('')}" stroke-width="${w}" stroke-opacity="${o}"/>`;
    })
    .join('');

  const svg =
    `<svg xmlns="http://www.w3.org/2000/svg" width="${TILE_W}" height="${spec.tileH}">` +
    `<g stroke="#fff" fill="none" stroke-linecap="round">${paths}</g></svg>`;

  /**
   * 用**最小化的百分号编码**，而不是 base64。
   *
   * SVG 是一串高度重复的文本（`M123 456l2 18` 这种），gzip 能压掉七成。
   * base64 把字节打散成 6 位一组，剩下的冗余几乎压不动 ——
   * 实测同样是 7 KB 的 SVG，base64 之后落在页面里要多出四成。
   *
   * 只需要转义这几个字符：`#`（颜色）、`<`、`>`。
   * 属性引号统一用单引号，就省掉了对 `"` 的转义。
   */
  const encoded = svg
    .replace(/"/g, "'")
    .replace(/#/g, '%23')
    .replace(/</g, '%3C')
    .replace(/>/g, '%3E')
    /* ⚠️ 空格必须转义。data URI 里裸空格不是合法 URI 字符：
       Chrome / Firefox 会宽松地自动编码，Safari 的解析器更严格 ——
       解析失败会让 mask-image 指向一张加载不出来的图，
       而 CSS mask 对"加载失败的图"的处理是**把元素整个遮掉**，
       表现出来就是"雨天背景正常，但一滴雨都看不到"。
       path 数据已经改用逗号分隔，这里剩下的空格只在标签属性之间。 */
    .replace(/ /g, '%20');

  return `data:image/svg+xml,${encoded}`;
}

/** 最大瓷砖高度 —— 下面 .rain__layer 的外扩量由它决定，改 LAYERS 时要同步 */
const MAX_TILE_H = Math.max(...LAYERS.map((l) => l.tileH));

/**
 * 窄屏使用的瓷砖尺寸。
 *
 * 小屏不需要那么大的瓷砖（屏宽只有 390），而且纯渐变没有 mask 的
 * 分辨率开销，瓷砖做小反而更容易做密。
 */
const MOBILE = {
  tileW: [140, 156, 172, 188, 204],
  tileH: [190, 212, 234, 256, 278],
  drops: [16, 13, 11, 8, 6],
};

/**
 * 生成移动端用的纯渐变雨滴。
 *
 * 每一个雨滴是一个**椭圆形的 radial-gradient**：椭圆的长短半径就是
 * 雨滴的长短与粗细，位置用 `at X% Y%` 指定。
 * 多条这样的渐变叠在同一个 background-size 里 —— 共用瓷砖尺寸是
 * 无缝循环的前提（位移距离必须等于瓷砖高度）。
 *
 * 为什么移动端不用 SVG mask：
 *   mask 这条路依赖 data URI，而 data URI 的编码在移动端浏览器上
 *   容错率明显更低（一条真实踩到的坑：URI 里的裸空格在 Chrome 会被
 *   自动编码，在 Safari 会让整张图加载失败，而 CSS mask 对加载失败的
 *   图是把元素整个遮掉 —— 表现为"背景正常但一滴雨都没有"）。
 *   纯渐变走的是 background-image，兼容性没有这层风险。
 */
function buildMobileGradients(spec: LayerSpec, count: number) {
  const rng = makeRng(spec.seed + 8123);
  const parts: string[] = [];

  for (let i = 0; i < count; i++) {
    // 长度：覆盖该层区间并略微越界，让长短差更明显
    const ry = spec.len[0] * 0.75 + rng() * (spec.len[1] - spec.len[0]) * 1.15;
    // 粗细：从该层最细到最粗之间取值
    const rx = spec.widths[0] * 0.42 + rng() * (spec.widths[2] - spec.widths[0]) * 0.42;
    const x = (rng() * 100).toFixed(1);
    const y = (rng() * 100).toFixed(1);
    // 透明度偏淡、少数明显（指数分布，和桌面端的加权抽签同一个取向）
    const alpha = Math.round((0.28 + Math.pow(rng(), 1.4) * 0.62) * 100);
    const c = `color-mix(in oklab, var(--rain-streak) ${alpha}%, transparent)`;

    parts.push(
      `radial-gradient(ellipse ${rx.toFixed(2)}px ${ry.toFixed(1)}px at ${x}% ${y}%, ${c} 0%, ${c} 40%, transparent 100%)`
    );
  }

  return parts.join(',\n      ');
}

/** 宽屏：逐滴 SVG mask。与之前完全一致，只是补上了 -webkit- 前缀。 */
const desktopCss = LAYERS.map((spec) => {
  const uri = buildMaskUri(spec);
  return `.rain__layer[data-layer='${spec.layer}'] {
  --tile-h: ${spec.tileH}px;
  --dur: ${spec.dur}s;
  --delay: ${spec.delay}s;
}
.rain__layer[data-layer='${spec.layer}'] .rain__cells {
  /* -webkit- 前缀与标准属性并存：
     Safari 15.4 起支持无前缀 mask，更早的版本只认 -webkit-。
     代价是这条 data URI 在 HTML 里出现两次，但重复内容 gzip 后几乎不增加体积。 */
  -webkit-mask-image: url("${uri}");
  mask-image: url("${uri}");
  -webkit-mask-size: ${TILE_W}px ${spec.tileH}px;
  mask-size: ${TILE_W}px ${spec.tileH}px;
  -webkit-mask-repeat: repeat;
  mask-repeat: repeat;
  -webkit-mask-position: 0 0;
  mask-position: 0 0;
}`;
}).join('\n');

/** 窄屏：纯渐变雨滴，不碰 mask、不碰 data URI。速度与桌面端逐层对应。 */
const mobileCss = LAYERS.map((spec, i) => {
  const tileW = MOBILE.tileW[i];
  const tileH = MOBILE.tileH[i];
  const speed = spec.tileH / spec.dur;
  const dur = (tileH / speed).toFixed(2);
  const gradients = buildMobileGradients(spec, MOBILE.drops[i]);

  return `.rain__layer[data-layer='${spec.layer}'] {
  --tile-h: ${tileH}px;
  --dur: ${dur}s;
}
.rain__layer[data-layer='${spec.layer}'] .rain__cells {
  background-color: transparent;
  background-image:
      ${gradients};
  background-size: ${tileW}px ${tileH}px;
  background-repeat: repeat;
}`;
}).join('\n');

const css = `
/* ── 窄屏（手机）：纯渐变雨滴 ── */
@media (max-width: 48rem) {
${mobileCss}
}

/* ── 宽屏：逐滴 SVG mask ── */
@media (min-width: 48.0625rem) {
${desktopCss}
}`;

/**
 * 外扩量的**唯一来源**：最大瓷砖高度 + 余量。
 * 写在这里而不是散在下面的样式里，是为了改 LAYERS 的 tileH 时不会漏掉 ——
 * 漏掉的表现是"循环到一半画面顶上露出一条空白"。
 */
const insetCss = `.rain__layer { inset: -${MAX_TILE_H + 60}px 0; }`;
---

<div class="rain" aria-hidden="true">
  <div class="rain__layer" data-layer="1"><div class="rain__cells"></div></div>
  <div class="rain__layer" data-layer="2"><div class="rain__cells"></div></div>
  <div class="rain__layer" data-layer="3"><div class="rain__cells"></div></div>
  <div class="rain__layer" data-layer="4"><div class="rain__cells"></div></div>
  <div class="rain__layer" data-layer="5"><div class="rain__cells"></div></div>
</div>

<style is:global set:html={css + insetCss} />

<style>
  .rain {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    display: none;
  }

  /* 只有雨天存在。其余天气下 display:none，动画完全不启动。 */
  :global([data-weather='rain']) .rain {
    display: block;
  }

  /* ⚠️ 这个元素只做 transform —— 不带 mask、不带 filter。
     带上任何一个都会让它无法被合成器接管，动画退回主线程并开始掉帧。 */
  .rain__layer {
    position: absolute;
    /* 外扩量由上面根据最大瓷砖高度生成（insetCss）。
       必须超过最大位移距离，否则循环到一半会露边；
       用固定像素而不是百分比 —— 窄页头只有 270px 高，按百分比算不够。 */
    will-change: transform;
    animation: rain-fall var(--dur) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes rain-fall {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      /* 位移 = mask 瓷砖的一个完整高度 → 首尾像素级重合 */
      transform: translate3d(0, var(--tile-h), 0);
    }
  }

  /* 静态层：底色取 token，形状由每层各自的 SVG mask 给出 */
  .rain__cells {
    position: absolute;
    inset: 0;
    background-color: var(--rain-streak);
  }

  /* 动效降级：雨滴留在画面上，但完全静止。
     必须用 animation: none !important ——
     base.css 会把时长压到 0.01ms，配着无限循环会让雨滴疯狂抖动。 */
  @media (prefers-reduced-motion: reduce) {
    .rain__layer {
      animation: none !important;
    }
  }
</style>
